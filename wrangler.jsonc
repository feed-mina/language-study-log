{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "language-study-log",
  "main": "worker.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "TIME_ZONE": "Asia/Seoul",
    "SITE_URL": "https://language-study-log.evolvix.workers.dev",
    "ACCESS_TEAM_DOMAIN": "https://nameless-tooth-30bb.cloudflareaccess.com",
    "ACCESS_AUD": "684f399d3a1259b68512b19b356f30d6d4f608a704b084b120133edd2b275008"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "language-study-log-db",
      "database_id": "2ef83ce5-1f8a-4a53-a6f8-c4fcefa96b70",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STUDY_ASSETS",
      "bucket_name": "language-study-log-assets"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
