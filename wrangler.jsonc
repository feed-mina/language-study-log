{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "language-study-log",
  "main": "worker.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "TIME_ZONE": "Asia/Seoul",
    "SITE_URL": "https://toeic-daily-study-log.minyerin.chatgpt.site"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "language-study-log-db",
      "database_id": "2ef83ce5-1f8a-4a53-a6f8-c4fcefa96b70",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STUDY_ASSETS",
      "bucket_name": "language-study-log-assets"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "triggers": {
    "crons": [
      "30 21 * * *",
      "0 23 * * *",
      "0 9 * * mon-sat"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
